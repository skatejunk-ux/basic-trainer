    "dexie": "4.4.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.6.2",
